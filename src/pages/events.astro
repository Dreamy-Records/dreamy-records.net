---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Events — Dreamy Records" page="events">
  <main class="page-shell dark-page events-page">
    <header class="page-title"><span>05 / EVENTS</span><h1>EVENTS</h1><p>イベント情報</p></header>
    <section class="event-history">
      <header class="event-reveal">
        <span>2026 EVENT SCHEDULE</span><h2>THIS YEAR</h2>
      </header>
      <article class="event-row event-reveal event-finished">
        <time datetime="2026-05-04"><b>5/4</b></time><div>
          <h3>第二十三回 博麗神社例大祭</h3><p>
            東京ビッグサイト 東展示棟 / 東京 · う05ab
          </p>
        </div><span class="event-status">FINISHED</span>
      </article>
      <article class="event-row event-reveal event-finished">
        <time datetime="2026-08-16"><b>8/16</b></time><div>
          <h3>C108</h3><p>東京ビッグサイト / 東京</p>
        </div><span class="event-status">FINISHED</span>
      </article>
      <article class="event-row event-reveal">
        <time datetime="2026-10-04"><b>10/4</b></time><div>
          <h3>第十三回 博麗神社秋季例大祭</h3><p>
            東京ビッグサイト / 東京
          </p>
        </div>
      </article>
      <article class="event-row event-reveal">
        <time datetime="2026-10-11"><b>10/11</b></time><div>
         <h3>東方紅楼夢</h3><p>
            インテックス大阪 / 大阪
          </p>
        </div>
      </article>
      <article class="event-row event-reveal">
        <time datetime="2026-12-30"><b>12/30</b></time><div>
         <h3>C109</h3><p>
            東京ビッグサイト / 東京
          </p>
        </div>
      </article>
    </section>
  </main>
</SiteLayout>
