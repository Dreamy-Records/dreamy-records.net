---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import NewsListing from '../components/NewsListing.astro';

const articlesPerPage = 10;
const articles = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const totalPages = Math.ceil(articles.length / articlesPerPage);
---

<SiteLayout title="News — Dreamy Records" page="news">
  <NewsListing
    articles={articles.slice(0, articlesPerPage)}
    currentPage={1}
    totalPages={totalPages}
    startIndex={0}
  />
</SiteLayout>
