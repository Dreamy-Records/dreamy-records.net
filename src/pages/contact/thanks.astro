---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Thank You — Dreamy Records"
  description="お問い合わせを受け付けました。"
  page="contact"
  noindex={true}
>
  <main class="page-shell dark-page thanks-page">
    <header class="page-title">
      <span>CONTACT / COMPLETE</span>
      <h1>THANK YOU</h1>
      <p>送信完了</p>
    </header>

    <section class="thanks-content contact-reveal">
      <span>MESSAGE RECEIVED</span>
      <h2>お問い合わせを<br />受け付けました。</h2>
      <p>送信いただきありがとうございます。内容を確認のうえ、通常3日以内にご連絡いたします。</p>
      <div class="thanks-actions">
        <a class="icon-action" href="/">
          <span>BACK TO HOME</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a class="icon-action" href="/contact/">
          <span>CONTACT</span>
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
