---
import type { CollectionEntry } from 'astro:content';
import { getNewsSlug } from '../utils/newsSlug';

interface Props {
  articles: CollectionEntry<'news'>[];
  currentPage: number;
  totalPages: number;
  startIndex: number;
}

const { articles, currentPage, totalPages, startIndex } = Astro.props;
const formatDate = (date: Date) =>
  date
    .toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .replaceAll('/', '.');
const years = [...new Set(articles.map((item) => item.data.date.getFullYear()))].sort((a, b) => b - a);
const categories = [...new Set(articles.map((item) => item.data.category))].sort((a, b) =>
  a.localeCompare(b, 'ja'),
);
const pageHref = (page: number) => (page === 1 ? '/news/' : `/news/page/${page}/`);
---

<main class="page-shell dark-page news-page">
  <header class="page-title"><span>02 / NEWS</span><h1>NEWS</h1><p>最新情報</p></header>
  <div class="news-tools-wrap profile-reveal">
    <form class="news-tools" data-news-filters>
      <label class="news-search">
        <span>SEARCH</span>
        <input type="search" placeholder="キーワードで検索" aria-label="ニュースを検索" data-news-search />
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      </label>
      <label class="news-filter">
        <span>YEAR</span>
        <select data-news-year aria-label="西暦で絞り込む">
          <option value="">すべての西暦</option>
          {years.map((year) => <option value={String(year)}>{year}</option>)}
        </select>
      </label>
      <label class="news-filter">
        <span>CATEGORY</span>
        <select data-news-category aria-label="カテゴリーで絞り込む">
          <option value="">すべてのカテゴリー</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <button class="news-filter-reset" type="reset">
        <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
        <span>RESET</span>
      </button>
    </form>
    <p class="news-filter-status" data-news-filter-status role="status" aria-live="polite"></p>
  </div>
  <section class="news-list">
    {
      articles.map((item, index) => (
        <a
          href={item.data.redirectTo ?? `/news/${getNewsSlug(item)}/`}
          class="news-row"
          data-news-row
          data-year={item.data.date.getFullYear()}
          data-category={item.data.category}
          data-search={`${item.data.title} ${item.data.category} ${formatDate(item.data.date)}`}
          aria-label={item.data.redirectTo ? `${item.data.title}（外部サイトへ移動）` : item.data.title}
        >
          <span class="news-index">{String(startIndex + index + 1).padStart(2, '0')}</span>
          <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
          <span class="category">{item.data.category}</span>
          <h2>{item.data.title}</h2>
          <i>↗</i>
        </a>
      ))
    }
  </section>
  {
    totalPages > 1 && (
      <nav class="news-pagination profile-reveal" aria-label="ニュースのページ送り">
        {currentPage > 1 ? (
          <a href={pageHref(currentPage - 1)}>
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>PREV</span>
          </a>
        ) : (
          <span class="news-pagination-spacer" aria-hidden="true" />
        )}
        <div>
          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) =>
            page === currentPage ? (
              <span aria-current="page">{String(page).padStart(2, '0')}</span>
            ) : (
              <a href={pageHref(page)}>{String(page).padStart(2, '0')}</a>
            ),
          )}
        </div>
        {currentPage < totalPages ? (
          <a href={pageHref(currentPage + 1)}>
            <span>NEXT</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        ) : (
          <span class="news-pagination-spacer" aria-hidden="true" />
        )}
      </nav>
    )
  }
</main>

<button
  class="news-floating-filter"
  type="button"
  data-news-floating-trigger
  aria-expanded="false"
  aria-controls="news-floating-filter-panel"
  aria-label="ニュースを絞り込む"
  hidden
>
  <i class="fa-solid fa-sliders" aria-hidden="true"></i>
</button>
<aside
  class="news-floating-filter-panel"
  id="news-floating-filter-panel"
  data-news-floating-panel
  aria-label="ニュースを絞り込む"
  hidden
>
  <header>
    <span>FILTER NEWS</span>
    <button type="button" data-news-floating-close aria-label="絞り込みを閉じる">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </header>
  <form class="news-tools news-floating-tools" data-news-filters>
    <label class="news-search">
      <span>SEARCH</span>
      <input type="search" placeholder="キーワードで検索" aria-label="ニュースを検索" data-news-search />
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    </label>
    <label class="news-filter">
      <span>YEAR</span>
      <select data-news-year aria-label="西暦で絞り込む">
        <option value="">すべての西暦</option>
        {years.map((year) => <option value={String(year)}>{year}</option>)}
      </select>
    </label>
    <label class="news-filter">
      <span>CATEGORY</span>
      <select data-news-category aria-label="カテゴリーで絞り込む">
        <option value="">すべてのカテゴリー</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
    </label>
    <button class="news-filter-reset" type="reset">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
      <span>RESET</span>
    </button>
  </form>
</aside>

<script>
  const filterForms = [...document.querySelectorAll<HTMLFormElement>('[data-news-filters]')];
  const primaryFilters = filterForms[0];
  const primarySearch = primaryFilters?.querySelector<HTMLInputElement>('[data-news-search]');
  const floatingTrigger = document.querySelector<HTMLButtonElement>('[data-news-floating-trigger]');
  const floatingPanel = document.querySelector<HTMLElement>('[data-news-floating-panel]');
  const floatingClose = document.querySelector<HTMLButtonElement>('[data-news-floating-close]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-news-row]')];
  const status = document.querySelector<HTMLElement>('[data-news-filter-status]');
  const normalize = (value: string) => value.toLocaleLowerCase('ja-JP').trim();
  let floatingTriggerAnimation: Animation | undefined;
  const controls = (form: HTMLFormElement) => ({
    search: form.querySelector<HTMLInputElement>('[data-news-search]'),
    year: form.querySelector<HTMLSelectElement>('[data-news-year]'),
    category: form.querySelector<HTMLSelectElement>('[data-news-category]'),
  });
  const closeFloatingFilters = (restoreFocus = true) => {
    if (!floatingPanel || !floatingTrigger) return;
    floatingPanel.hidden = true;
    floatingTrigger.setAttribute('aria-expanded', 'false');
    if (restoreFocus && !floatingTrigger.hidden) floatingTrigger.focus();
  };
  const showFloatingTrigger = () => {
    if (!floatingTrigger) return;
    floatingTriggerAnimation?.cancel();
    floatingTrigger.hidden = false;
    floatingTriggerAnimation = floatingTrigger.animate(
      [
        { opacity: 0, transform: 'scale(0.65)' },
        { opacity: 1, transform: 'scale(1.1)', offset: 0.72 },
        { opacity: 1, transform: 'scale(1)' },
      ],
      { duration: 380, easing: 'cubic-bezier(0.2, 1.45, 0.45, 1)', fill: 'both' },
    );
  };
  const hideFloatingTrigger = () => {
    if (!floatingTrigger || floatingTrigger.hidden) return;
    floatingTriggerAnimation?.cancel();
    const animation = floatingTrigger.animate(
      [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.92)' }],
      { duration: 180, easing: 'ease-out', fill: 'both' },
    );
    floatingTriggerAnimation = animation;
    animation.onfinish = () => {
      if (floatingTriggerAnimation !== animation) return;
      floatingTrigger.hidden = true;
      floatingTriggerAnimation = undefined;
    };
  };
  const updateNews = (source = primaryFilters) => {
    if (!source) return;
    const sourceControls = controls(source);
    const query = normalize(sourceControls.search?.value ?? '');
    const year = sourceControls.year?.value ?? '';
    const category = sourceControls.category?.value ?? '';
    filterForms.forEach((form) => {
      if (form === source) return;
      const targetControls = controls(form);
      if (targetControls.search) targetControls.search.value = sourceControls.search?.value ?? '';
      if (targetControls.year) targetControls.year.value = year;
      if (targetControls.category) targetControls.category.value = category;
    });
    let count = 0;
    rows.forEach((row) => {
      const matches =
        (!query || normalize(row.dataset.search ?? '').includes(query)) &&
        (!year || row.dataset.year === year) &&
        (!category || row.dataset.category === category);
      row.hidden = !matches;
      if (matches) count += 1;
    });
    if (status) status.textContent = count ? `${count}件の記事を表示中` : '該当する記事がありません。';
  };
  filterForms.forEach((form) => {
    const formControls = controls(form);
    formControls.search?.addEventListener('input', () => updateNews(form));
    formControls.year?.addEventListener('change', () => updateNews(form));
    formControls.category?.addEventListener('change', () => updateNews(form));
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      updateNews(form);
    });
    form.addEventListener('reset', () => requestAnimationFrame(() => updateNews(form)));
  });
  floatingTrigger?.addEventListener('click', () => {
    if (!floatingPanel) return;
    const isOpen = !floatingPanel.hidden;
    floatingPanel.hidden = isOpen;
    floatingTrigger.setAttribute('aria-expanded', String(!isOpen));
    if (!isOpen) floatingPanel.querySelector<HTMLInputElement>('[data-news-search]')?.focus();
  });
  floatingClose?.addEventListener('click', () => closeFloatingFilters());
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && floatingPanel && !floatingPanel.hidden) closeFloatingFilters();
  });
  if (primarySearch && floatingTrigger) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) hideFloatingTrigger();
        else showFloatingTrigger();
        if (entry.isIntersecting && floatingPanel && !floatingPanel.hidden) closeFloatingFilters(false);
      },
      { threshold: 0 },
    ).observe(primarySearch);
  }
  updateNews(primaryFilters);
</script>
